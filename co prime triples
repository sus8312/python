def cop(a,b):
    return gcd(a,b)==1
def gcd(a,b):
    while(b!=0):
       remainder=a%b
       temp=b 
       b=remainder
       a=temp
        
    return a 
n=int(input("Enter any num:"))
for a in range(5,n):
    for b in range(4,a):
        for c in range(3,b):
            if c*c+b*b+a*a and cop(a,b) and cop(a,c) and cop(b,c):
                print(c,b,a)
